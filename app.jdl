application {
  config {
    baseName Morocco2030,
    applicationType monolith,
    packageName com.morocco2030.app,
    authenticationType jwt,
    databaseType sql,
    devDatabaseType postgresql,
    prodDatabaseType postgresql,
    cacheProvider no,
    buildTool maven,
    skipClient true,
    skipUserManagement false,
    enableSwaggerCodegen true
  }
  entities *
}

/**
 * Extension du User JHipster
 */
entity UserProfile {
    phoneNumber String,
    birthDate LocalDate,
    nationality String,
    preferredLanguage String
}

entity Permission {
    name String required unique,
    description String,
    code String required unique
}

entity UserPermission {
    grantedAt Instant,
    isActive Boolean
}

// RELATIONS CORRIGÉES
relationship OneToOne {
    // On précise que User est une entité intégrée
    UserProfile{user(login) required} to User with builtInEntity
}

relationship ManyToOne {
    // Ici aussi pour la table de liaison
    UserPermission{user(login) required} to User with builtInEntity,
    UserPermission{permission(name) required} to Permission
}

dto * with mapstruct
service * with serviceImpl
paginate * with pagination
